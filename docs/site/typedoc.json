{
  "$schema": "https://typedoc.org/schema.json",
  "name": "a11ylabel",
  "entryPoints": [
    "../../src/index.ts"
  ],
  "tsconfig": "./tsconfig.json",
  "out": "../../site",
  "readme": "./index.md",
  "projectDocuments": [
    "../guides/claiming-labels.md",
    "../guides/larger-text.md",
    "../guides/dark-interface.md",
    "../guides/reduced-motion.md",
    "../guides/voiceover.md",
    "../guides/contrast-color-media.md"
  ],
  "customCss": "./theme.css",
  "navigationLinks": {
    "GitHub": "https://github.com/muhittincamdali/a11ylabel"
  },
  "sourceLinkTemplate": "https://github.com/muhittincamdali/a11ylabel/blob/{gitRevision}/{path}#L{line}",
  "excludePrivate": true,
  "excludeInternal": true,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": false
  },
  "treatWarningsAsErrors": true,
  "alwaysCreateEntryPointModule": false,
  "highlightLanguages": [
    "bash",
    "dart",
    "javascript",
    "js",
    "json",
    "jsx",
    "objc",
    "sh",
    "swift",
    "text",
    "ts",
    "tsx",
    "typescript",
    "xml",
    "yaml"
  ]
}
